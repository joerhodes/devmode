#!/usr/bin/env bash
#
# devmode — switch between isolated Mac development environments (Herd,
# larakit, etc.) with one command. Each environment is a conf file in
# ~/.config/devmode/ defining devmode_up/devmode_down, built from small
# idempotent primitives (brew, docker, compose, open/osascript). Switching
# modes fully tears down the outgoing environment before bringing up the
# new one, so exclusive resources (ports, dnsmasq) never collide.
#
# Usage: devmode <environment>   e.g. devmode herd | devmode larakit
#        devmode list
#        devmode status
#        devmode stop
#

# failures are checked explicitly - don't set errexit
set -uo pipefail

DEVMODE_CONFIG_DIR="${DEVMODE_CONFIG_DIR:-$HOME/.config/devmode}"

#
# Display usage information
#
usage() {
    echo "Usage: devmode <environment>   e.g. devmode herd | devmode larakit"
    echo "       devmode list"
    echo "       devmode status"
    echo "       devmode stop"
}

# =============================================================================
#  Private functions to support the Public API below
# =============================================================================

#
# display_status_line — display a status line for a given environment label and up/down status
#     $1 — label
#     $2 — is_up (0 = up, 1 = down)
#
display_status_line() {
    local label="$1"
    local is_up="$2"   # 0 = up, 1 = down

    local GREEN='\033[0;32m'
    local RED='\033[0;31m'
    local RESET='\033[0m'

    if [[ "$is_up" -eq 0 ]]; then
        printf "${GREEN}●${RESET} %s up\n" "$label"
    else
        printf "${RED}●${RESET} %s down\n" "$label"
    fi
}

#
# sudo_will_prompt — check if sudo will prompt for a password
#
sudo_will_prompt() {
    ! sudo -n true 2>/dev/null
}

#
# resolve_compose_file — resolve a docker-compose.yml path or directory to the actual compose file path
#     $1 — path to docker-compose.yml or directory
#
resolve_compose_file() {
    local path="$1"

    if [[ -d "$path" ]]; then
        echo "${path%/}/docker-compose.yml"
    else
        echo "$path"
    fi
}

# =============================================================================
#  Public functions - prefixed with "devmode::"
# =============================================================================

#
# devmode::brew_status — display the status of a brew service
#     $1 — service name
#
devmode::brew_status() {
    local service="$1"
    if launchctl print "system/homebrew.mxcl.${service}" &>/dev/null; then
        display_status_line "$service" 0
        return 0
    else
        display_status_line "$service" 1
        return 1
    fi
}

#
# devmode::brew_start — start a brew service
#     $1 — service name
#
devmode::brew_start() {
    local service="$1"

    if launchctl print "system/homebrew.mxcl.${service}" &>/dev/null; then
        return 0
    fi

    if sudo_will_prompt; then
        echo "Starting ${service} requires sudo — you may be prompted for your password."
    fi
    sudo brew services start "$service" 2>/dev/null
}

#
# devmode::brew_stop — stop a brew service
#     $1 — service name
#
devmode::brew_stop() {
    local service="$1"

    if ! launchctl print "system/homebrew.mxcl.${service}" &>/dev/null; then
        return 0
    fi

    if sudo_will_prompt; then
        echo "Stopping ${service} requires sudo — you may be prompted for your password."
    fi
    sudo brew services stop "$service"
}

#
# devmode::app_status — display the status of an app
#     $1 — app name
#
devmode::app_status() {
    local app="$1"
    if pgrep -xq "$app"; then
        display_status_line "$app" 0
        return 0
    else
        display_status_line "$app" 1
        return 1
    fi
}

#
# devmode::app_launch — launch a GUI app if it isn't already running
#     $1 — app name (as it appears in Applications / osascript)
#
devmode::app_launch() {
    local app="$1"

    if pgrep -xq "$app"; then
        return 0
    fi

    open -a "$app"
}

#
# devmode::app_quit — quit a GUI app if it's currently running
#     $1 — app name
#
devmode::app_quit() {
    local app="$1"

    if ! pgrep -xq "$app"; then
        return 0
    fi

    osascript -e "quit app \"${app}\"" &>/dev/null
}
#
# devmode::docker_desktop_status — display the status of Docker Desktop
#
devmode::docker_desktop_status() {
    if docker info &>/dev/null; then
        display_status_line "Docker Desktop" 0
        return 0
    else
        display_status_line "Docker Desktop" 1
        return 1
    fi
}

#
# devmode::docker_desktop_launch — start Docker Desktop if it isn't
# already running, and wait until it's ready
#
devmode::docker_desktop_launch() {
    if docker info &>/dev/null; then
        return 0
    fi

    docker desktop start
}

#
# devmode::docker_desktop_quit — stop Docker Desktop if it's running
#
devmode::docker_desktop_quit() {
    if ! docker info &>/dev/null; then
        return 0
    fi

    docker desktop stop
}

#
# devmode::docker_status — display the status of a Docker container
#     $1 — container name
#
devmode::docker_status() {
    local container="$1"

    if [[ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" == "true" ]]; then
        display_status_line "$container" 0
        return 0
    else
        display_status_line "$container" 1
        return 1
    fi
}

#
# devmode::docker_start — start a container if it isn't already running
# (ensures Docker Desktop is up first — see devmode::docker_desktop_launch)
#     $1 — container name
#
devmode::docker_start() {
    devmode::docker_desktop_launch

    local container="$1"

    if [[ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" == "true" ]]; then
        return 0
    fi

    docker start "$container"
}

#
# devmode::docker_stop — stop a container if it's currently running
#     $1 — container name
#
devmode::docker_stop() {
    local container="$1"

    if [[ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" != "true" ]]; then
        return 0
    fi

    docker stop "$container"
}

#
# devmode::compose_status — report whether a compose project has any
# running containers
#     $1 — path to docker-compose.yml
#
devmode::compose_status() {
    local compose_file
    compose_file=$(resolve_compose_file "$1")
    local label
    label=$(basename "$(dirname "$compose_file")")

    if docker compose -f "$compose_file" ps --status running -q 2>/dev/null | grep -q .; then
        display_status_line "$label" 0
        return 0
    else
        display_status_line "$label" 1
        return 1
    fi
}

#
# devmode::compose_up — bring a compose project up if it isn't already
# (ensures Docker Desktop is up first)
#     $1 — path to docker-compose.yml
#
devmode::compose_up() {
    devmode::docker_desktop_launch

    local compose_file
    compose_file=$(resolve_compose_file "$1")

    if docker compose -f "$compose_file" ps --status running -q 2>/dev/null | grep -q .; then
        return 0
    fi

    docker compose -f "$compose_file" up -d
}

#
# devmode::compose_down — bring a compose project down if it's running
#     $1 — path to docker-compose.yml
#
devmode::compose_down() {
    local compose_file
    compose_file=$(resolve_compose_file "$1")

    if ! docker compose -f "$compose_file" ps --status running -q 2>/dev/null | grep -q .; then
        return 0
    fi

    docker compose -f "$compose_file" down
}

# =============================================================================
#  Private functions
# =============================================================================

#
# list_environments — list all available environment configurations
#
list_environments() {
    local conf name
    for conf in "$DEVMODE_CONFIG_DIR"/*.conf; do
        [[ -e "$conf" ]] || continue

        name=$(basename "$conf" .conf)

        if [[ "$name" =~ [[:space:]\*\?\[\]] ]]; then
            echo "Warning: skipping '${name}.conf' — environment names may not contain whitespace or glob characters (* ? [ ])" >&2
            continue
        fi

        echo "$name"
    done
}

#
# display_environments — list all available environment configurations
#
display_environments() {
    local envs
    envs=$(list_environments)

    if [[ -z "$envs" ]]; then
        echo "No environments found in $DEVMODE_CONFIG_DIR"
        return 1
    fi

    echo "Available environments ($DEVMODE_CONFIG_DIR):"
    for name in $envs; do
        echo "  $name"
    done
}

#
# display_statuses — display the status of all available environment configurations
#
display_statuses() {
    local envs
    envs=$(list_environments)

    if [[ -z "$envs" ]]; then
        echo "No environments found in $DEVMODE_CONFIG_DIR"
        return 1
    fi

    local name
    for name in $envs; do
        echo "${name}:"
        ( source "$DEVMODE_CONFIG_DIR/${name}.conf"; devmode_status )
        echo
    done

    return 0
}

#
# active_environments — list all environments that are currently active
#
active_environments() {
    local envs name matches=()
    envs=$(list_environments)

    for name in $envs; do
        if ( source "$DEVMODE_CONFIG_DIR/${name}.conf"; devmode_status ) &>/dev/null; then
            matches+=("$name")
        fi
    done

    # awkwardness caused by Apple's Bash version
    printf '%s\n' "${matches[@]+"${matches[@]}"}"
}

#
# stop_environments — stop all environments that are currently active
#
stop_environments() {
    local active name
    active=$(active_environments)

    if [[ -z "$active" ]]; then
        echo "No environments currently active."
        return 0
    fi

    local overall=0
    for name in $active; do
        echo "Stopping ${name}..."
        if ! ( source "$DEVMODE_CONFIG_DIR/${name}.conf"; devmode_down ); then
            echo "  Warning: devmode_down for ${name} did not exit cleanly." >&2
            overall=1
        fi
    done

    return "$overall"
}

#
# switch_environment — switch to a specific environment
#
switch_environment() {
    local target="$1"

    local active
    active=$(active_environments)

    if [[ "$active" == "$target" ]]; then
        echo "${target} is already active — nothing to do."
        return 0
    fi

    if ! stop_environments; then
        echo "Failed to stop currently active environment(s) — aborting switch to ${target}." >&2
        return 1
    fi

    echo "Starting ${target}..."
    if ! ( source "$DEVMODE_CONFIG_DIR/${target}.conf"; devmode_up ); then
        echo "devmode_up for ${target} did not exit cleanly." >&2
        return 1
    fi
}

#
# main — entrypoint for the devmode CLI
#
main() {
    local cmd="${1:-}"

    case "$cmd" in
        list)   display_environments ;;
        status) display_statuses ;;
        stop)
            stop_environments
            devmode::docker_desktop_quit
            ;;
        help)
            usage
            return 0
            ;;
        "")
            usage >&2
            return 1
            ;;
        *)
            if ! grep -qx "$cmd" < <(list_environments); then
                echo "Unknown environment: $cmd" >&2
                return 1
            fi
            switch_environment "$cmd"
            ;;
    esac
}

# Only run main when executed directly — allows this script to be sourced
# (e.g. by BATS tests) without triggering execution.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
